VITE_API_URL=

VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# SharePoint tenant root URL (used by the Tour Profile file picker).
# Example: https://innovationae.sharepoint.com
VITE_SP_TENANT_URL=

# Optional: SharePoint site the picker opens on by default. When unset, opens
# on the tenant root. Useful when EMS docs live in one specific site.
# Example: https://innovationae.sharepoint.com/sites/EMS
VITE_SP_SITE_URL=

VITE_APP_SUITE=all

VITE_GOOGLE_PLACES_API_KEY=

VITE_DOCUMENT_TOGGLE_OID=
